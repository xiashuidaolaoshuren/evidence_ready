# Server-only OpenRouter API key. Never expose this to the browser or log it.
# Required for live extraction and answer interpretation in a private deployment.
# Recorded fixture mode works without a key when EVIDENCEREADY_PUBLIC_DEMO=1.
# Copy this file to .env.local (gitignored) and fill in the value.
OPENROUTER_API_KEY=

# Public demo: set to 1 to hide live extract/upload and reject live API calls with 403.
# Playwright sets this automatically. Leave unset for private deployments.
# EVIDENCEREADY_PUBLIC_DEMO=1

# Optional: log model prompt/response excerpts locally (ignored on Vercel).
# EVIDENCEREADY_LOG_MODEL_CONTENT=1
